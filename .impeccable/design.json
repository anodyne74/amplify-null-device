  "narrative": {
    "northStar": "The Dispatch Desk",
    "overview": "One desk, three seats: administrators at a desktop, Operators with a phone in a van after dark, Customers checking a Route. Calm, rounded and tonal, with a single indigo accent marking what can be acted on or what is current.",
    "keyCharacteristics": [
      "One accent (indigo) plus a rare violet; amber and red reserved for planned/warning and danger.",
      "Pill-shaped actions, 12-16px rounded containers, hairline borders.",
      "Comfortaa for headings, Manrope for reading, JetBrains Mono for identifiers.",
      "Light and dark for every role; Operators default to dark; staff sidebar always navy.",
      "Role accent, focus ring and active-nav tints come from role tokens."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Indigo is the only action color. Violet decorates; it never marks something clickable.",
        "section": "colors"
      },
      {
        "name": "The Red Is Earned Rule",
        "body": "Red appears only for overdue, failed or destructive states, including on invoices.",
        "section": "colors"
      },
      {
        "name": "The Role Token Rule",
        "body": "Shared components read the role tokens, never a hard-coded role color or a hard-coded dark or light shell.",
        "section": "colors"
      },
      {
        "name": "The Heading Face Rule",
        "body": "Comfortaa is for headings; everything else is Manrope. Never set body copy in Comfortaa.",
        "section": "typography"
      },
      {
        "name": "The Response-Only Glow Rule",
        "body": "Glows and lifts appear as a reaction to hover or focus, never at rest.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the unprefixed tokens and app/components/ui/ primitives for new UI.",
      "Do keep indigo as the only action color and reserve red for danger, overdue and failure.",
      "Do make every role support light and dark through the shared resolved theme mode.",
      "Do keep touch targets at 44px minimum, and 52px for primary Operator actions.",
      "Do give active navigation aria-current=\"page\" and a visible role-tinted focus ring.",
      "Do confirm destructive and replacement actions."
    ],
    "donts": [
      "Don't mix neon accents across equal-priority cards in the Customer portal.",
      "Don't hard-code a role shell to dark or light where the shared theme is available.",
      "Don't show invoices, balances or restricted placeholders to read_only Customers.",
      "Don't nest cards or use marketing-style hero compositions in operational workflows.",
      "Don't let global typography or button rules override MUI or Amplify component states.",
      "Don't put glow or lift on resting elements."
    ]
  }
}