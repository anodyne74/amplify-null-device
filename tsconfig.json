{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    /* baseUrl is deprecated as of TS 6.0 and will stop working in TS 7.0.
       Not migrating off it as part of a dependency bump — silencing for
       now, migrate deliberately later. */
    "ignoreDeprecations": "6.0",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    /* Path mapping for cleaner imports */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "$amplify/*": [
        "./.amplify/generated/*"
      ],
      "@aws-amplify/backend/function/runtime": [
        "./node_modules/@aws-amplify/backend/lib/function/runtime/index.d.ts"
      ]
    },
    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "allowJs": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "amplify",
    "app",
    "next-env.d.ts",
    "src",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vite.config.ts",
    "vite.config.js",
    ".next",
    "out"
  ]
}
